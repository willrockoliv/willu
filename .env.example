DB_PASSWORD=postgres
DB_USER=postgres
DB_NAME=willu_financas
DB_HOST=db # Para executar a aplicação diretamente no host, substitua db por localhost.
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}
DATABASE_URL_SYNC=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

APP_TITLE=Willu - Finanças Pessoais
DEBUG=true
